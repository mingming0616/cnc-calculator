rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 刀具庫:登入後才能讀寫
    match /tools/{toolId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.data.keys().hasAll(['category','name','d','material'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.d is number
                   && request.resource.data.d > 0;
    }

    // 工件工時表:登入後才能讀寫
    match /jobs/{jobId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
                   && request.resource.data.keys().hasAll(['name','ops'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.ops is list
                   && request.resource.data.ops.size() <= 60;
    }
  }
}
