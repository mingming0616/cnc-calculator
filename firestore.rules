rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 刀具庫
    match /tools/{toolId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && validTool(request.resource.data);
    }

    // 工件工時表
    match /jobs/{jobId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && validJob(request.resource.data);
    }

    function validTool(t) {
      return t.keys().hasOnly(['category','name','erp','brand','d','z','pitch','material','vc','feed','ap','ae','price','lifePcs','note','updatedAt'])
        && t.category in ['endmill','facemill','drill','reamer','chamfer','tap']
        && t.name is string && t.name.size() > 0 && t.name.size() <= 100
        && t.d is number && t.d > 0 && t.d <= 500
        && (t.erp == '' || t.erp.matches('^[A-Z0-9]{15}$'))
        && t.note.size() <= 300;
    }

    function validJob(j) {
      return j.name is string && j.name.size() > 0 && j.name.size() <= 100
        && j.ops is list && j.ops.size() <= 60;
    }
  }
}
